 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% if letter_head %}\r\n    {{ letter_head }}\r\n{% endif %}\r\n{% set taxRate = 0 %}\r\n{% if doc.taxes %}\r\n      {% set taxRate = doc.taxes[0].rate %}\r\n      {% set item_wise_tax_detail = doc.taxes[0].item_wise_tax_detail  %}\r\n{% endif %}\r\n<hr>\r\n<p class=\"text-center\" style=\"font-size: 1.125rem; margin-bottom: 1rem\">\r\n\t<b>{{ doc.select_print_heading or _(\"Tax Invoice\") }}</b><br>\r\n</p>\r\n<div class=\"row\">\r\n    <div class=\"col-xs-12\">\r\n        <div class=\"col-xs-7\"></div>\r\n        <div class=\"col-xs-5\" style=\"height: 48px;\">\r\n            <div style=\"height: 48px;\" >{{ get_barcode(doc.name) }}</div>\r\n        </div>\r\n    </div>\r\n    <div class=\"col-xs-7\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Customer Name\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.customer_name }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Customer Address\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.address_display }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Contact Person\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.contact_person }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Billing Address\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.shipping_address }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n    <div class=\"col-xs-5\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Invoice No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.name }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"PO No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.po_no }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"SO No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n                {% set slots = [] %}\r\n                {% for d in doc.get(\"items\") if d.sales_order and d.sales_order not in slots %}\r\n                {{ d.sales_order|e }}\r\n                {{ slots.append(d.sales_order) or \"\" }}\r\n            \t{% endfor %}\r\n            </span>\r\n        </div>\r\n        <div>\r\n            <div class=\"row row-no-gutters\">\r\n                <span class=\"col-xs-5\">\r\n                \t<b>{{ _(\"DO No.\") }}:</b>\r\n                </span>\r\n                <span class=\"col-xs-7\">\r\n                    {{ doc.delivery_note }}\r\n                </span>\r\n            </div>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Date\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n                {{ doc.get_formatted(\"posting_date\") }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Term\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.payment_terms_template or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5\">\r\n            \t<b>{{ _(\"Due Date\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7\">\r\n            \t{{ doc.get_formatted(\"due_date\") }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n</div>\r\n<hr>\r\n<table class=\"table\">\r\n\t<thead>\r\n\t\t<tr class=\"table-header\">\r\n\t\t\t<th width=\"5%\" class=\"text-center\">{{ _(\"S/N\") }}</th>\r\n\t\t\t<th width=\"20%\" class=\"text-left\">{{ _(\"Description\") }}</th>\r\n\t\t\t<th width=\"15%\" class=\"text-center\">{{ _(\"Weight\") }}</th>\r\n\t\t\t<th width=\"15%\" class=\"text-center\">{{ _(\"SKU\") }}</th>\r\n\t\t\t<th width=\"7%\" class=\"text-center\">{{ _(\"Qty\") }}</th>\r\n\t\t\t<th width=\"7%\" class=\"text-left\">{{ _(\"Pack/Carton\") }}</th>\r\n\t\t\t<th width=\"12%\" class=\"text-right\">{{ _(\"Unit Price\") }}<br>({{doc.currency}})</th>\r\n\t\t\t<th width=\"10%\" class=\"text-right\">{{ _(\"Amount\") }}<br>({{doc.currency}})</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t{%- for item in doc.items -%}\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.idx }}<br></td>\r\n\t\t\t<td class=\"text-left no-border\">\r\n\t\t\t\t{{ item.item_code }}\r\n\t\t\t\t{%- if item.item_name != item.item_code -%}\r\n\t\t\t\t\t<br>{{ item.marketing_name or item.item_name }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t\t<!--{%- if item.item_name != item.description -%}-->\r\n\t\t\t\t<!--\t<br> {{ item.description }}-->\r\n\t\t\t\t<!--{%- endif -%}-->\r\n\t\t\t\t{%- if item.serial_no -%}\r\n\t\t\t\t\t<br><b>{{ _(\"SR.No\") }}:</b><br>\r\n\t\t\t\t\t{{ item.serial_no | replace(\"\\n\", \", \") }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.weight }}<br></td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.sku }}<br></td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.qty }}<br></td>\r\n\t\t\t<td class=\"text-left no-border\">{{ item.uom_name }}<br></td>\r\n\t\t\t<td class=\"text-right no-border\">{{ item.get_formatted(\"rate\", hide_symbol=1) }}</td>\r\n\t\t\t<td class=\"text-right no-border\">{{ item.get_formatted(\"amount\", hide_symbol=1) }}</td>\r\n\t\t</tr>\r\n\t\t{%- endfor -%}\r\n\t\t<tr>\r\n    \t\t<td class=\"text-right\" colspan=\"7\">\r\n    \t\t\t<b>{{ _(\"Sub-total\") }}</b>\r\n    \t\t</td>\r\n    \t\t<td class=\"text-right\">\r\n    \t\t\t{{ doc.get_formatted(\"total\", hide_symbol=1) }}\r\n    \t\t</td>\r\n\t\t</tr>\r\n\t\t\t{%- if taxRate > 0 and doc.total_taxes_and_charges > 0 -%}\r\n\t\t<tr>\r\n    \t\t<td class=\"text-right no-border\" colspan=\"7\">\r\n    \t\t  <b>{{ _(\"GST@\")}} {{taxRate}} {{_(\"%\") }}</b>\r\n    \t\t</td>\r\n    \t\t<td class=\"text-right no-border\">\r\n    \t\t\t{{ doc.get_formatted(\"total_taxes_and_charges\", hide_symbol=1) }}\r\n    \t\t</td>\r\n\t\t</tr>\r\n\t\t\t{%- endif -%}\r\n\t\t\t{%- if taxRate == 0 and doc.total_taxes_and_charges  > 0 -%}\r\n\t\t<tr>\r\n    \t\t<td class=\"text-right no-border\" colspan=\"7\">\r\n    \t\t\t<b>{{ _(\"GST@\")}} {{json.loads(item_wise_tax_detail).values()|map(attribute=0)|max}} {{_(\"%\") }}</b>\r\n    \t\t</td>\r\n    \t\t<td class=\"text-right no-border\">\r\n    \t\t\t{{ doc.get_formatted(\"total_taxes_and_charges\", hide_symbol=1) }}\r\n    \t\t</td>\r\n\t\t</tr>\r\n\t\t{%-endif-%}\r\n\t\t<tr>\r\n    \t\t<td class=\"text-right no-border\" colspan=\"7\">\r\n    \t\t\t<b>{{ _(\"Total\") }}</b>\r\n    \t\t</td>\r\n    \t\t<td class=\"text-right no-border\">\r\n    \t\t\t{{ doc.get_formatted(\"grand_total\", hide_symbol=1) }}\r\n    \t\t</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n<hr>\r\n<p class=\"text-left\">{{ doc.terms or \"\" }}</p>\r\n<div id=\"footer-html\">\r\n    {% if not no_letterhead and footer %}\r\n    <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n    </div>\r\n    {% endif %}\r\n</div>",
