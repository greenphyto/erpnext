 "html": "{% if letter_head %}\r\n    {{ letter_head }}\r\n{% endif %}\r\n<p class=\"text-center\" style=\"font-size: 1.125rem; margin-bottom: 1rem\">\r\n\t<b>{{ doc.select_print_heading or _(\"Packing Slip\") }}</b><br>\r\n</p>\r\n<div class=\"row\">\r\n    <div class=\"col-xs-7\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Invoice No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.name }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Shipper\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.shipper }}<br>\r\n            \t{{ doc.shipper_address or \"\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Shipper Contact\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Importer\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.importer }}<br>\r\n            \t{{ doc.importer_display or \"\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Importer Contact\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                \r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Commercial Invoice No\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Mode of Transport\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.get(\"mode_of_transport\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Port of Loading\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.get(\"port_of_loading\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n    <div class=\"col-xs-5\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Invoice Date\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ doc.get_formatted(\"posting_date\") }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Country of Origin\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ frappe.db.get_value(\"Company\", doc.company, \"country\") }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Destination\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ frappe.db.get_value(\"Address\", doc.shipping_address_name, \"country\") }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"PO Number\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ doc.po_no or \"N.A.\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Destination\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Incoterms\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ doc.get(\"inter_company_terms\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Port of Discharge\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ doc.get(\"port_of_discharge\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Currency\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ doc.currency }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n</div>\r\n<br>\r\n<table class=\"table\">\r\n\t<thead>\r\n\t\t<tr class=\"table-header\">\r\n\t\t\t<th width=\"5%\" class=\"text-center\">{{ _(\"Item\") }}</th>\r\n\t\t\t<th width=\"35%\" class=\"text-left\">{{ _(\"Product\") }}</th>\r\n\t\t\t<th width=\"12%\" class=\"text-center\">{{ _(\"HS Code\") }}</th>\r\n\t\t\t<th width=\"13%\" class=\"text-center\">{{ _(\"Qty\") }}</th>\r\n\t\t\t<th width=\"15%\" class=\"text-right\">{{ _(\"Unit Price\") }}</th>\r\n\t\t\t<th width=\"15%\" class=\"text-right\">{{ _(\"Total Price\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-left\">{{ _(\"Remarks\") }}</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t{%- for item in doc.items -%}\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.idx }}</td>\r\n\t\t\t<td class=\"text-left no-border\">\r\n\t\t\t\t{{ item.item_code }}\r\n\t\t\t\t{%- if item.item_name != item.item_code -%}\r\n\t\t\t\t\t<br>{{ item.item_name }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.get(\"gst_hs_code\") or item.get(\"customs_tariff_number\") or \"-\" }}</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.qty }}</td>\r\n\t\t\t<td class=\"text-right no-border\">{{ item.get_formatted(\"rate\") }}</td>\r\n\t\t\t<td class=\"text-right no-border\">{{ item.get_formatted(\"amount\") }}</td>\r\n\t\t\t<td class=\"text-left no-border\">{{ item.get(\"remarks\") or \"\" }}</td>\r\n\t\t</tr>\r\n\t\t{%- endfor -%}\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-right no-border\" colspan=\"5\"><b>{{ _(\"Total\") }}</b></td>\r\n\t\t\t<td class=\"text-right no-border\"><b>{{ doc.get_formatted(\"total\", doc) }}</b></td>\r\n\t\t\t<td class=\"no-border\"></td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n<div class=\"row\" style=\"margin-top: unset !important;\">\r\n    <div class=\"col-xs-7\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Handling Instruction\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                \r\n            </span>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div id=\"footer-html\">\r\n    {% if not no_letterhead and footer %}\r\n    <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n    </div>\r\n    {% endif %}\r\n</div>",
