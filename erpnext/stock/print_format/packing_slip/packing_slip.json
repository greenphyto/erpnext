 "html": "{% if letter_head %}\r\n    {{ letter_head }}\r\n{% endif %}\r\n<p class=\"text-center\" style=\"font-size: 1.125rem; margin-bottom: 1rem\">\r\n\t<b>{{ _(\"Packing Slip\") }}</b><br>\r\n</p>\r\n<div class=\"row\">\r\n    <div class=\"col-xs-7\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Packing Slip No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.name }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Delivery Note\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.delivery_note }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Shipper\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.shipper }}<br>\r\n            \t{{ doc.shipper_address or \"\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Shipper Contact\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.shipper_contact or \"\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Importer\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.importer }}<br>\r\n            \t{{ doc.importer_address or \"\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Importer Contact\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ doc.importer_contact or \"\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Mode of Transport\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.get(\"mode_of_transport\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Port of Loading\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.get(\"port_of_loading\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n    <div class=\"col-xs-5\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Date.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                {{ doc.get_formatted(\"posting_date\") }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Package No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                {{ doc.from_case_no }} {% if doc.to_case_no and doc.to_case_no != doc.from_case_no %}to {{ doc.to_case_no }}{% endif %}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Country of Origin\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t{{ doc.country_of_origin or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Destination\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                {{ doc.destination or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"PO No\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                {{ doc.po_no or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Incoterms\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                {{ doc.get(\"inter_company_terms\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Unit per Carton\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                {{ doc.unit_per_carton or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-6 line-height\">\r\n            \t<b>{{ _(\"Carton Weight\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-6 line-height\">\r\n                {{ doc.carton_weight or \"-\" }} KG\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Port of Discharge\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.get(\"port_of_discharge\") or \"-\" }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n</div>\r\n<br>\r\n<table class=\"table\">\r\n\t<thead>\r\n\t\t<tr class=\"table-header\">\r\n\t\t\t<th width=\"5%\" class=\"text-center\">{{ _(\"No\") }}</th>\r\n\t\t\t<th width=\"25%\" class=\"text-left\">{{ _(\"Item Code\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-center\">{{ _(\"Qty\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-center\">{{ _(\"UOM\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-center\">{{ _(\"Cartons\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-right\">{{ _(\"Net Weight\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-right\">{{ _(\"Gross Weight\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-center\">{{ _(\"Weight UOM\") }}</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t{%- for item in doc.items -%}\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.idx }}</td>\r\n\t\t\t<td class=\"text-left no-border\">\r\n                item.item_name\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.qty }}</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.uom_view }}</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.cartons or \"-\" }}</td>\r\n\t\t\t<td class=\"text-right no-border\">{{ frappe.utils.flt(item.net_weight,2) or \"-\" }}</td>\r\n\t\t\t<td class=\"text-right no-border\">{{ frappe.utils.flt(item.gross_weight,2) or \"-\" }}</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.weight_uom or \"-\" }}</td>\r\n\t\t</tr>\r\n\t\t{%- endfor -%}\r\n\t</tbody>\r\n</table>\r\n<div class=\"row\" style=\"margin-top: 1rem;\">\r\n\t<div class=\"col-xs-12\">\r\n\t\t<div class=\"row row-no-gutters\">\r\n\t\t\t<span class=\"col-xs-3 line-height\">\r\n\t\t\t\t<b>{{ _(\"Total Net Weight\") }}:</b>\r\n\t\t\t</span>\r\n\t\t\t<span class=\"col-xs-3 line-height\">\r\n\t\t\t\t{{ frappe.utils.flt(doc.net_weight_pkg,2) or 0 }} {{ doc.net_weight_uom or \"\" }}\r\n\t\t\t</span>\r\n\t\t\t<span class=\"col-xs-3 line-height\">\r\n\t\t\t\t<b>{{ _(\"Total Gross Weight\") }}:</b>\r\n\t\t\t</span>\r\n\t\t\t<span class=\"col-xs-3 line-height\">\r\n\t\t\t\t{{ frappe.utils.flt(doc.gross_weight_pkg,2) or 0 }} {{ doc.gross_weight_uom or \"\" }}\r\n\t\t\t</span>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n<div class=\"row\" style=\"margin-top: unset !important;\">\r\n    <div class=\"col-xs-12\">\r\n        {% if doc.handling_instruction %}\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-12 line-height\">\r\n            \t<b>{{ _(\"Handling Instruction\") }}:</b>\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-12 line-height\">\r\n                {{ doc.handling_instruction }}\r\n            </span>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n</div>\r\n<div id=\"footer-html\">\r\n    {% if not no_letterhead and footer %}\r\n    <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n    </div>\r\n    {% endif %}\r\n</div>",
