 "css": ".line-height {\n    line-height: 1rem;    \n}\n\n.table-header {\n    border-bottom: 0.063rem;\n}\n\n.no-border {\n    border-top: 0 !important;\n}\n\n.signature {\n    padding-top: 3.125rem;\n    border-bottom: 0.063rem solid black;\n    width: 9.375rem;\n}\n\nhr {\n    border: none;\n}",
