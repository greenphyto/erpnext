 "html": "<br><br>\r\n{% if letter_head %}\r\n    {{ letter_head }}\r\n{% endif %}\r\n<p class=\"text-center\" style=\"font-size: 1.125rem; margin-bottom: 1rem\">\r\n\t<b>{{ doc.select_print_heading or _(\"Delivery Note\") }}</b><br>\r\n</p>\r\n<div class=\"row\">\r\n    <div class=\"col-xs-7\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Customer Name\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.customer_name }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Customer Address\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n            \t{{ doc.address_display }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-5 line-height\">\r\n            \t<b>{{ _(\"Shipping Address\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-7 line-height\">\r\n                {{ frappe.db.get_value(\"Address\", doc.shipping_address_name, \"address_title\") }}\r\n                <br>\r\n            \t{{ doc.shipping_address }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n    <div class=\"col-xs-5\">\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-4 line-height\">\r\n            \t<b>{{ _(\"DO No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-8 line-height\">\r\n            \t{{ doc.name }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-4 line-height\">\r\n            \t<b>{{ _(\"Date\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-8 line-height\">\r\n                {{ doc.get_formatted(\"posting_date\") }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-4 line-height\">\r\n            \t<b>{{ _(\"PO No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-8 line-height\">\r\n                {{ doc.po_no or \"-\" }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-4 line-height\">\r\n            \t<b>{{ _(\"SO No.\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-8 line-height\">\r\n               {% set slots = [] %}\r\n                {% for d in doc.get(\"items\") if d.against_sales_order and d.against_sales_order not in slots %}\r\n                {{ d.against_sales_order|e }}\r\n                {{ slots.append(d.against_sales_order) or \"\" }}\r\n            \t{% endfor %}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-4 line-height\">\r\n            \t<b>{{ _(\"Collect Person\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-8 line-height\">\r\n                {{ doc.contact_person }}\r\n            </span>\r\n        </div>\r\n        <div class=\"row row-no-gutters\">\r\n            <span class=\"col-xs-4 line-height\">\r\n            \t<b>{{ _(\"Delivery Date\") }}:</b>\r\n            </span>\r\n            <span class=\"col-xs-8 line-height\">\r\n                {{ doc.get_formatted(\"delivery_date\") }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n</div>\r\n<hr>\r\n<table class=\"table\">\r\n\t<thead>\r\n\t\t<tr class=\"table-header\">\r\n\t\t\t<th width=\"5%\" class=\"text-center\">{{ _(\"S/N\") }}</th>\r\n\t\t\t<th width=\"30%\" class=\"text-left\">{{ _(\"Description\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-center\">{{ _(\"Weight\") }}</th>\r\n\t\t\t<th width=\"12%\" class=\"text-left\">{{ _(\"SKU\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-center\">{{ _(\"Qty\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-left\">{{ _(\"Pack\") }}</th>\r\n\t\t\t<th width=\"10%\" class=\"text-left\">{{ _(\"Carton\") }}</th>\r\n\t\t\t<th width=\"20%\" class=\"text-left\">{{ _(\"Lot No\") }}</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t{%- for item in doc.items -%}\r\n\t\t<tr>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.idx }}<br></td>\r\n\t\t\t<td class=\"text-left no-border\">\r\n\t\t\t\t{{ item.item_code }}\r\n\t\t\t\t{%- if item.item_name != item.item_code -%}\r\n\t\t\t\t\t<br>{{ item.marketing_name or item.item_name }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t\t<!--{%- if item.item_name != item.description -%}-->\r\n\t\t\t\t<!--\t<br> {{ item.description }}-->\r\n\t\t\t\t<!--{%- endif -%}-->\r\n\t\t\t\t{%- if item.serial_no -%}\r\n\t\t\t\t\t<br><b>{{ _(\"SR.No\") }}:</b><br>\r\n\t\t\t\t\t{{ item.serial_no | replace(\"\\n\", \", \") }}\r\n\t\t\t\t{%- endif -%}\r\n\t\t\t</td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.weight_per_unit }}<br></td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.sku or \"-\" }}<br></td>\r\n\t\t\t<td class=\"text-center no-border\">{{ item.qty }}<br></td>\r\n\t\t\t<td class=\"text-left no-border\">{{ item.uom_name }}<br></td>\r\n\t\t\t<td class=\"text-left no-border\">{{ frappe.utils.cint(item.qty/12) }}<br></td>\r\n\t\t\t<td class=\"text-left no-border\">{{ item.get_formatted(\"foms_lot_name\") }}<br></td>\r\n\t\t</tr>\r\n\t\t{%- endfor -%}\r\n\t\t<tr>\r\n\t\t    {% if doc.flags.show_inclusive_tax_in_print %}\r\n\t\t\t\t<td class=\"text-right\" colspan=\"7\">\r\n\t\t\t\t{#\t{{ _(\"Total Excl. Tax\") }}#}\r\n\t\t\t\t</td>\r\n\t\t\t\t<td class=\"text-left\">\r\n\t\t\t\t{#\t{{ doc.get_formatted(\"net_total\", doc) }}#}\r\n\t\t\t\t</td>\r\n\t\t\t{% else %}\r\n\t\t\t\t<td class=\"text-right\" colspan=\"7\">\r\n\t\t\t\t{#\t{{ _(\"Total\") }}#}\r\n\t\t\t\t</td>\r\n\t\t\t\t<td class=\"text-left\">\r\n\t\t\t\t{#\t{{ doc.get_formatted(\"total\", doc) }}#}\r\n\t\t\t\t</td>\r\n\t\t\t{% endif %}\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n<hr>\r\n<p>{{ doc.terms or \"\" }}</p>\r\n<p class=\"text-left\">{{ _(\"Goods Received By:\") }}</p>\r\n<div class=\"signature\"><p class=\"text-left\"></p></div>\r\n<p class=\"text-left\">{{ _(\"Date:\") }}</p>\r\n<div id=\"footer-html\">\r\n    {% if not no_letterhead and footer %}\r\n    <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n    </div>\r\n    {% endif %}\r\n</div>",
