 "font_size": 14,
 "html": "{% if letter_head %}\r\n  {{ letter_head }}\r\n{% endif %}\r\n\r\n<hr>\r\n<p class=\"text-center\" style=\"font-size: 1.125rem; margin-bottom: 1rem\">\r\n  <b>{{ _(\"Payment Approval\") }}</b><br>\r\n  <span style=\"font-size: 0.9rem; color: #666;\">{{ doc.name }}</span>\r\n</p>\r\n\r\n<div class=\"row\">\r\n  <div class=\"col-xs-6\">\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Company\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.company }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Posting Date\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.get_formatted(\"posting_date\") }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Time\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.get_formatted(\"time\") }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Status\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.status }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Batch Number\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.batch_number or \"-\" }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Process ID\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.process_id or \"-\" }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Transfer Date\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.get_formatted(\"transfer_date\") or \"-\" }}</span>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"col-xs-6\">\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Payment Type\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.payment_type }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Payment Method\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.payment_method or \"-\" }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Payment Property\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.payment_property or \"-\" }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Cheque Method\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.cheque_method or \"-\" }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Purpose\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.purpose }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Purpose Description\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.purpose_description or \"-\" }}</span>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<div class=\"row\">\r\n  <div class=\"col-xs-6\">\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Currency\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.currency }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Bank Account\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.bank_account }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Bank\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.bank }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Account\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.account }}</span>\r\n    </div>\r\n  </div>\r\n  <div class=\"col-xs-6\">\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Bank Account Name\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.bank_account_name }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Bank Account No\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.bank_account_no }}</span>\r\n    </div>\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"SWIFT\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.swift or \"-\" }}</span>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"row\" style=\"margin-top: 8px;\">\r\n  <div class=\"col-xs-6\">\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Requested By\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.requested_by }}</span>\r\n    </div>\r\n  </div>\r\n  <div class=\"col-xs-6\">\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Approved By\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.approved_by or \"-\" }}</span>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"row\" style=\"margin-top: 4px;\">\r\n  <div class=\"col-xs-6\">\r\n    <div class=\"row row-no-gutters\">\r\n      <span class=\"col-xs-6\"><b>{{ _(\"Update On\") }}:</b></span>\r\n      <span class=\"col-xs-6\">{{ doc.get_formatted(\"update_on\") or \"-\" }}</span>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<table class=\"table\">\r\n  <thead>\r\n    <tr class=\"table-header\">\r\n      <th width=\"30%\" class=\"text-left\">{{ _(\"Invoice No\") }}</th>\r\n      <th width=\"20%\" class=\"text-left\">{{ _(\"Bill No\") }}</th>\r\n      <th width=\"15%\" class=\"text-left\">{{ _(\"Status\") }}</th>\r\n      <th width=\"20%\" class=\"text-right\">{{ _(\"Amount\") }}</th>\r\n      <th width=\"15%\" class=\"text-center\">{{ _(\"Currency\") }}</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% set all_rows = doc.invoices or [] %}\r\n    {% for supplier_group in all_rows|groupby('party') %}\r\n      <tr>\r\n        <td colspan=\"5\" class=\"no-border\" style=\"background:#f7f7f7\"><b>{{ _(\"Supplier\") }}:</b> {{ supplier_group.grouper }}</td>\r\n      </tr>\r\n      {% for bank_group in supplier_group.list|groupby('bank_account_no') %}\r\n        {% set first = bank_group.list[0] %}\r\n        <tr>\r\n          <td colspan=\"5\" class=\"no-border\">\r\n            <b>{{ _(\"Bank\") }}:</b> {{ first.supplier_bank }}\r\n            <br><b>{{ _(\"Account No\") }}:</b> {{ first.bank_account_no }}\r\n            <br><b>{{ _(\"Account Name\") }}:</b> {{ first.bank_account_name }}\r\n            <br><b>{{ _(\"SWIFT\") }}:</b> {{ first.swift }}\r\n            <br><b>{{ _(\"Currency\") }}:</b> {{ first.currency }}\r\n          </td>\r\n        </tr>\r\n        {% for row in bank_group.list %}\r\n          <tr>\r\n            <td class=\"text-left no-border\">{{ row.invoice_no }}</td>\r\n            <td class=\"text-left no-border\">{{ row.bill_no or '' }}</td>\r\n            <td class=\"text-left no-border\">{{ row.status or '' }}</td>\r\n            <td class=\"text-right no-border\">{{ row.get_formatted('amount', hide_symbol=1) }}</td>\r\n            <td class=\"text-center no-border\">{{ row.currency }}</td>\r\n          </tr>\r\n        {% endfor %}\r\n      {% endfor %}\r\n    {% endfor %}\r\n    <tr>\r\n      <td colspan=\"1\"></td>\r\n      <td class=\"text-right\" colspan=\"2\"><b>{{ _(\"Total Amount\") }}</b></td>\r\n      <td class=\"text-right\"><b>{{ doc.get_formatted('total_amount', hide_symbol=1) }}</b></td>\r\n      <td colspan=\"\"></td>\r\n    </tr>\r\n  </tbody>\r\n</table>\r\n\r\n<div id=\"footer-html\">\r\n  {% if not no_letterhead and footer %}\r\n  <div class=\"letter-head-footer\">\r\n    {{ footer }}\r\n  </div>\r\n  {% endif %}\r\n</div>\r\n",
